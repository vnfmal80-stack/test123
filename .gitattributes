# Normalize line endings: LF in the repo, native in the working copy
* text=auto eol=lf

# Binary assets — never touch these
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated — collapse in diffs and PR reviews
package-lock.json linguist-generated=true diff=json
